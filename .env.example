# Optional identity package on Sui testnet. Populate from an authorized deployment.
# Leave empty to keep undeployed identity features disabled; native SuiNS still works.
NEXT_PUBLIC_IDENTITY_PACKAGE_ID=
NEXT_PUBLIC_IDENTITY_NAMES_ID=

# Call target defaults to testnet v7:
# 0xca0650d406b4e8b1b80c7c52fa205369fcf4614d401849196d14021389fac212.
# A compatible upgrade mints a NEW package id; the old one keeps resolving only its
# original functions. Type/event identities stay with their defining package, so
# objects created before an upgrade keep their original type spelling.
NEXT_PUBLIC_PROPOSAL_PACKAGE_ID=

# Additive governance_poll module for public manual/group/hybrid polls.
# Present in default testnet v7; an empty value follows NEXT_PUBLIC_PROPOSAL_PACKAGE_ID.
# Override only with a verified compatible deployment; module presence is not wallet E2E evidence.
NEXT_PUBLIC_GOVERNANCE_PACKAGE_ID=

# Additive scheduled_payments module for funded recurring and streaming payments.
# Present in default testnet v7; an empty value follows NEXT_PUBLIC_PROPOSAL_PACKAGE_ID.
# No external-wallet auto-debit or background scheduler is implied by this setting.
NEXT_PUBLIC_SCHEDULED_PAYMENTS_PACKAGE_ID=

# Isolated red_packet_v2 type with Sui randomness. No fallback to legacy creation.
# Present in default testnet v7; an empty value follows NEXT_PUBLIC_PROPOSAL_PACKAGE_ID.
# The client verifies the live ABI and canonical ChatChannel origin before use.
NEXT_PUBLIC_RED_PACKET_V2_PACKAGE_ID=

# Sealed organization treasury, exact funding-vault bindings and approved SUI transfers.
# Present in default testnet v7; an empty value follows NEXT_PUBLIC_PROPOSAL_PACKAGE_ID.
# Override only with a verified compatible deployment; module presence is not wallet E2E evidence.
NEXT_PUBLIC_ORGANIZATION_TREASURY_PACKAGE_ID=

# Explicit AgentVault package override. Empty follows default testnet v7.
NEXT_PUBLIC_AGENT_VAULT_PACKAGE_ID=

# Walrus App Policy module and shared registry IDs.
# Empty package follows NEXT_PUBLIC_PROPOSAL_PACKAGE_ID.
# The registry object ID has no on-chain discovery event and must be explicitly supplied if used.
NEXT_PUBLIC_WALRUS_APP_POLICY_PACKAGE_ID=
NEXT_PUBLIC_WALRUS_APP_REGISTRY_ID=

# Legacy keystore flags are ignored. Web keystore export/signing has been removed.
# Use an extension wallet, Passkey or zkLogin; keep CLI keys outside the web app.

# Google zkLogin on Sui testnet. These are SERVER variables: do not use NEXT_PUBLIC_.
# Exact canonical origin; no trailing slash. HTTP is accepted only for localhost development.
ZKLOGIN_ORIGIN=http://localhost:3000

# Google Cloud Web application OAuth client; register the exact redirect URI:
# http://localhost:3000/auth/callback (or your HTTPS origin + /auth/callback).
ZKLOGIN_GOOGLE_CLIENT_ID=

# Generate with: openssl rand -hex 32
# Keep stable and identical on all server instances. At least 32 random characters.
ZKLOGIN_SESSION_SECRET=

# Required HTTPS salt-provider endpoint. POST {"jwt":"..."}; return {"salt":"..."}.
# Salt must be a stable, recoverable decimal u128 for the verified (iss,aud,sub).
ZKLOGIN_SALT_URL=
# Optional Authorization: Bearer credential sent only by the server.
ZKLOGIN_SALT_API_KEY=

# Required HTTPS endpoint implementing the standard Mysten zkLogin prover JSON contract.
# See docs/zklogin.md. Its proving key must match Sui testnet.
ZKLOGIN_PROVER_URL=
# Optional Authorization: Bearer credential sent only by the server.
ZKLOGIN_PROVER_API_KEY=

# Sui testnet USDT has no canonical type published by Tether. Leave empty to
# hide USDT in invoice/request pickers; set the exact type an operator accepts.
# Example shape only — verify against the issuer before relying on it.
NEXT_PUBLIC_USDT_COIN_TYPE=

# Optional reference price feed used on the dashboard and asset list. Off unless
# NEXT_PUBLIC_PRICE_FEED=on; values are third-party estimates, not redemption prices.
NEXT_PUBLIC_PRICE_FEED=
NEXT_PUBLIC_PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price

# Official Sui Stack Messaging (Beta) — an additional end-to-end encrypted
# transport for the group conversation. The on-chain `onchain_chat` channel is
# still the default and works without any of this. Leave empty to keep the
# encrypted transport in its "relayer not configured" state; no message is
# invented and its composer stays disabled.
# The SDK has no public canonical relayer: run the reference Rust relayer in
# `MystenLabs/sui-stack-messaging/relayer` yourself. Browsers require HTTPS,
# except http://localhost / http://127.0.0.1 during local development.
# The health check only proves the process is reachable. The reference relayer
# keeps messages in memory and archives to Walrus one-way (it never reads them
# back), so durability needs an indexer plus a recovery transport.
NEXT_PUBLIC_SSM_RELAYER_URL=
# Optional comma-separated Seal key server object IDs. Defaults to the two
# official testnet servers used by the upstream e2e suite (2-of-2 threshold).
NEXT_PUBLIC_SSM_SEAL_KEY_SERVERS=
