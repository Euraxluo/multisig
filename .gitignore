# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored on purpose: pnpm installs each workspace package's direct
# dependencies into its own node_modules/ (packages/multisig/node_modules).
node_modules/

# next.js
/.next/
/out/

# production
/build

# sui move build output (contracts/*/build/, incl. bytecode_modules, debug_info, sources)
contracts/*/build/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts