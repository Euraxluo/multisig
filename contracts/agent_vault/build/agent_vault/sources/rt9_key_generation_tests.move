#[test_only]
module agent_vault::rt9_key_generation_tests;

use std::debug;
use sui::{
    clock::{Self, Clock},
    coin::{Self},
    sui::SUI,
    test_scenario::{Self as ts},
    tx_context::TxContext,
};
use agent_vault::{
    asynchronous_proposal::{Self as proposal, Proposal},
    cryptographic_org::{Self as org, Organization},
    organization_treasury::{Self as treasury, OrganizationTreasury, TransferBinding},
    vault::{Self, AgentVault},
};

const ALICE: address = @0xA11CE;
const BOB: address = @0xB0B;
const RELAYER: address = @0xEE7E;
const RECIPIENT: address = @0x9999;

// ed25519 fixture keys (org_pop_tests provenance): SK1 = 0xab*32 (old key),
// SK2 = 0xcd*32 (rotated-to key).
const PK1: vector<u8> = x"248acbdbaf9e050196de704bea2d68770e519150d103b587dae2d9cad53dd930";
const PK2: vector<u8> = x"fc947730f49eb01427a66e050733294d9e520e545c7a27125a780634e0860a27";

// === V2 fixtures (Round-9, regenerated by multisig scripts/rt9-fixtures-v2.mjs) ===

// OLD key (SK1) over the POST-rotate V2 transfer digest:
//   SHA256("SUI_ORG_TREASURY_TRANSFER_V2:" || "sui-testnet:" || ORG_RT9 ||
//          bcs(2) || bcs(2) || PROP_R || bcs(RECIPIENT) || bcs(30) || bcs(2))
// ORG_RT9  = derive_id(1, 1)   (clock in txn0, org in txn1)
// PROP_R   = derive_id(5, 0)   (transfer created in txn5)
// epoch=2, nonce=2, key_generation=2 (post-rotate). Old shards must NOT verify.
const SIG_OLDKEY_TRANSFER: vector<u8> = x"cf4148dc6103cd6382dfbbb05741ea693f0b430f58f0e4a08e813ecd8158943fa06f034418a4759d897bff3b5b7b53a3716cce3ff59fca0812659e7485182504";

// OLD key (SK1) over the PRE-rotate V2 advance digest:
//   SHA256("SUI_ORG_EPOCH_ADVANCE_V2:" || "sui-testnet:" || ORG_NO_CLOCK ||
//          bcs(1) || bcs(2) || bcs(2) || bcs(1))
// ORG_NO_CLOCK = derive_id(0, 1). Valid only while key_generation == 1; the
// rotation in the regression consumes that nonce, so replaying this digest
// after rotation must fail signature verification against the NEW key.
const SIG_OLDKEY_ADVANCE: vector<u8> = x"333245c9e8bc24f51d96af705ce9a44406bf18ede9c1c527d0f75c52c0f8a4db616e99a7a01f52a44de0dbb205bc93bd4f522f5010f6ffc958749a6795c34e0e";

// NEW key (SK2) over the POST-rotate V2 advance digest:
//   SHA256("SUI_ORG_EPOCH_ADVANCE_V2:" || "sui-testnet:" || ORG_NO_CLOCK ||
//          bcs(3) || bcs(4) || bcs(4) || bcs(2))
// epoch=3 (after advance+rotate), nonce=4, next=4, key_generation=2. Only
// holders of the new key can produce it: the positive control for (b).
// OLD key (SK1) over the V2 advance digest at nonce=1:
//   SHA256(... || bcs(1) || bcs(1) || bcs(2) || bcs(1)) — used by the
//   key_generation lifecycle test for its first (nonce-1) advance.
const SIG_OLDKEY_ADVANCE_N1: vector<u8> = x"c41a952dccf8e6095e496fd89ea41412146eb69e6b976c2cdd433951308d889ace3d991bf5aaf3a92488f36a10b5b20fb13d52d4b92e3cb5d715750efa831c0f";

const SIG_NEWKEY_ADVANCE: vector<u8> = x"a16cd1d7156a69c6ffb4f2c7415ce78b49afccdc83911e81e5d1f6c053a7d3d555194ced542c640227cb5001fc02d2a4b98206c23ba6c5d45e233529ef43ee09";

fun ctx(s: &mut ts::Scenario): &mut TxContext {
    ts::ctx(s)
}

// === Regression (a): after rotate_group_key, old-key shards cannot sign the
// === new V2 treasury transfer digest (resharing window is closed) ===

#[test, expected_failure(abort_code = 2701, location = agent_vault::asynchronous_proposal)]
fun old_key_cannot_sign_post_rotate_transfer_digest() {
    let mut s = ts::begin(ALICE);
    let mut clock = clock::create_for_testing(ctx(&mut s));
    clock::set_for_testing(&mut clock, 1_000);
    ts::next_tx(&mut s, ALICE);
    let org_id = org::create_organization_for_testing(PK1, 2, 2, vector[ALICE, BOB], vector[1, 1], ctx(&mut s));

    // rotate to PK2: epoch 1 -> 2, key_generation 1 -> 2.
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::rotate_group_key_for_testing(&mut o, 1, PK2, vector[ALICE, BOB], 2, ctx(&mut s));
        assert!(org::key_generation(&o) == 2, 1);
        ts::return_shared(o);
    };

    // treasury + funding
    ts::next_tx(&mut s, ALICE);
    let treasury_id = {
        let o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        let t = treasury::new(&o, ctx(&mut s));
        let tid = object::id(&t);
        treasury::share(t);
        ts::return_shared(o);
        tid
    };
    ts::next_tx(&mut s, ALICE);
    let vault_id = {
        let t = ts::take_shared_by_id<OrganizationTreasury>(&mut s, treasury_id);
        let (_, v_id, _) = treasury::custody_ids(&t);
        ts::return_shared(t);
        let mut vault = ts::take_shared_by_id<AgentVault<SUI>>(&mut s, v_id);
        vault::deposit(&mut vault, coin::mint_for_testing<SUI>(100, ctx(&mut s)));
        ts::return_shared(vault);
        v_id
    };

    // approved transfer bound to the treasury (amount 30 -> RECIPIENT)
    ts::next_tx(&mut s, ALICE);
    let (proposal_id, binding_id) = create_bound_transfer(&mut s, &clock, treasury_id, org_id, 30, RECIPIENT);
    ts::next_tx(&mut s, ALICE);
    approve(&mut s, &clock, org_id, proposal_id);
    ts::next_tx(&mut s, BOB);
    approve(&mut s, &clock, org_id, proposal_id);

    // Execute with the OLD-key signature over the post-rotate V2 digest
    // (epoch=2, nonce=2, kg=2): the V2 digest binds key_generation=2 and the
    // live key is PK2, so the SK1 signature must abort 2701.
    ts::next_tx(&mut s, RELAYER);
    execute_with_sig(&mut s, treasury_id, binding_id, org_id, proposal_id, vault_id, &clock, 2, SIG_OLDKEY_TRANSFER);

    ts::end(s);
    clock::destroy_for_testing(clock);
}

// === Regression (b): after rotate, the pre-rotate V2 advance digest is no
// === longer valid — replaying it aborts E_INVALID_SIGNATURE ===

#[test, expected_failure(abort_code = agent_vault::cryptographic_org::E_INVALID_SIGNATURE)]
fun old_advance_digest_cannot_replay_after_rotation() {
    let mut s = ts::begin(ALICE);
    let org_id = org::create_organization_for_testing(PK1, 2, 2, vector[ALICE, BOB], vector[1, 1], ctx(&mut s));

    // 1. Advance once legitimately at key_generation == 1 (nonce 2):
    //    consumes SIG_OLDKEY_ADVANCE and lands epoch 2.
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::advance_organization_epoch(&mut o, 2, SIG_OLDKEY_ADVANCE, ctx(&mut s));
        assert!(org::epoch_version(&o) == 2, 1);
        assert!(org::key_generation(&o) == 1, 2);
        ts::return_shared(o);
    };

    // 2. rotate to PK2 (nonce 3): key_generation 1 -> 2, group key PK1 -> PK2.
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::rotate_group_key_for_testing(&mut o, 3, PK2, vector[ALICE, BOB], 2, ctx(&mut s));
        assert!(org::key_generation(&o) == 2, 3);
        ts::return_shared(o);
    };

    // 3. Old-key holder replays the SAME pre-rotate advance digest at a fresh
    //    nonce: V2 domain + key_generation binding mean the digest no longer
    //    matches what the (new) verifier builds, so abort 1001. Under the old
    //    V1 layout (no key_generation) the epoch-1 approval would have been
    //    replayable inside the resharing window — the exact Round-9 P0 hole.
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::advance_organization_epoch(&mut o, 4, SIG_OLDKEY_ADVANCE, ctx(&mut s));
        ts::return_shared(o);
    };

    ts::end(s);
}

// === Positive control for (b): the NEW key signs the post-rotate V2 advance
// === digest and epoch advances normally after rotation ===

#[test]
fun new_key_signs_post_rotate_advance_digest() {
    let mut s = ts::begin(ALICE);
    let org_id = org::create_organization_for_testing(PK1, 2, 2, vector[ALICE, BOB], vector[1, 1], ctx(&mut s));

    // advance at kg=1 (nonce 2, pre-rotate digest consumed) -> epoch 2
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::advance_organization_epoch(&mut o, 2, SIG_OLDKEY_ADVANCE, ctx(&mut s));
        ts::return_shared(o);
    };

    // rotate (nonce 3) -> epoch 2... wait: rotate bumps to 3? No: advance made epoch 2,
    // rotate bumps epoch 2 -> 3 and kg 1 -> 2.
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::rotate_group_key_for_testing(&mut o, 3, PK2, vector[ALICE, BOB], 2, ctx(&mut s));
        assert!(org::epoch_version(&o) == 3, 1);
        assert!(org::key_generation(&o) == 2, 2);
        assert!(org::group_pk(&o) == PK2, 3);
        ts::return_shared(o);
    };

    // NEW-key signature over V2 digest (epoch=2, nonce=2, next=3, kg=2) —
    // signed for the epoch the rotation produced, so it verifies and advances.
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::advance_organization_epoch(&mut o, 4, SIG_NEWKEY_ADVANCE, ctx(&mut s));
        assert!(org::epoch_version(&o) == 4, 4);
        assert!(org::last_nonce(&o) == 4, 5);
        ts::return_shared(o);
    };

    ts::end(s);
}

// === Regression (c): key_generation increments exactly on rotation and only
// === on rotation (advance/roster changes leave it untouched) ===

#[test]
fun key_generation_increments_only_on_rotation() {
    let mut s = ts::begin(ALICE);
    let org_id = org::create_organization_for_testing(PK1, 2, 2, vector[ALICE, BOB], vector[1, 1], ctx(&mut s));

    // creation paths: key_generation == 1
    ts::next_tx(&mut s, ALICE);
    {
        let o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        assert!(org::key_generation(&o) == 1, 1);
        ts::return_shared(o);
    };

    // epoch advance (resharing semantics) must NOT bump key_generation
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::advance_organization_epoch(&mut o, 1, SIG_OLDKEY_ADVANCE_N1, ctx(&mut s));
        assert!(org::key_generation(&o) == 1, 2);
        ts::return_shared(o);
    };

    // first rotation: 1 -> 2
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::rotate_group_key_for_testing(&mut o, 2, PK2, vector[ALICE, BOB], 2, ctx(&mut s));
        assert!(org::key_generation(&o) == 2, 3);
        ts::return_shared(o);
    };

    // second rotation (rotate back to PK1 semantics: any 32B key) : 2 -> 3
    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        org::rotate_group_key_for_testing(&mut o, 3, PK1, vector[ALICE, BOB], 2, ctx(&mut s));
        assert!(org::key_generation(&o) == 3, 4);
        assert!(org::epoch_version(&o) == 4, 5);
        ts::return_shared(o);
    };

    ts::end(s);
}

// === Production-path rotation also bumps the generation (event carries it) ===

#[test]
fun production_rotation_event_carries_new_generation() {
    let mut s = ts::begin(ALICE);
    let org_id = org::create_organization_for_testing(PK1, 2, 3, vector[ALICE, BOB], vector[2, 1], ctx(&mut s));

    ts::next_tx(&mut s, ALICE);
    {
        let mut o = ts::take_shared_by_id<Organization>(&mut s, org_id);
        // Rotation digest (V3) + PoP fixtures come from the org_pop regression
        // set: same org layout (create_organization_for_testing, no clock),
        // same nonce, same signers/threshold.
        org::rotate_group_key(
            &mut o, 1, PK2, vector[ALICE, BOB], 2,
            x"c1f01de552ab0873cce4ea255f089c553fbc6abe870c7dcfbb83d8be023731e590c39a164523e86390a639b08779fd68eeaea85e0e14f177723d05faf0c7720f",
            x"11bc50464743ba610ae12194b37f6b8f8283df5ea5fed4ff1fefe0f3ae00087e7e1cac6a8cdf301201d8e29e68896a1aebba7135f3913a9c633198fab6b80b0e",
            ctx(&mut s),
        );
        assert!(org::key_generation(&o) == 2, 1);
        ts::return_shared(o);
    };
    // Event payload: GroupKeyRotatedEvent ends with key_generation = 2.
    let events = sui::event::events_by_type<org::GroupKeyRotatedEvent>();
    assert!(events.length() == 1, 2);
    debug::print(&org::rotated_event_generation(&events[events.length() - 1]));
    assert!(org::rotated_event_generation(&events[events.length() - 1]) == 2, 3);

    ts::end(s);
}

// === helpers (mirrored from transfer_gate_tests) ===

fun create_bound_transfer(
    scenario: &mut ts::Scenario,
    clock: &Clock,
    treasury_id: ID,
    org_id: ID,
    amount: u64,
    recipient: address,
): (ID, ID) {
    let treas = ts::take_shared_by_id<OrganizationTreasury>(scenario, treasury_id);
    let organization = ts::take_shared_by_id<Organization>(scenario, org_id);
    let proposal_id = treasury::create_transfer(
        &treas, &organization, b"rt9 regression payment", recipient, amount, 100_000, clock, ts::ctx(scenario),
    );
    let events = sui::event::events_by_type<treasury::TransferCreated>();
    let (binding_id, _, _) = treasury::transfer_created_fields(&events[events.length() - 1]);
    ts::return_shared(organization);
    ts::return_shared(treas);
    (proposal_id, binding_id)
}

fun approve(scenario: &mut ts::Scenario, clock: &Clock, org_id: ID, proposal_id: ID) {
    let mut p = ts::take_shared_by_id<Proposal>(scenario, proposal_id);
    let organization = ts::take_shared_by_id<Organization>(scenario, org_id);
    let weight = org::member_weight(&organization, ts::sender(scenario));
    proposal::submit_async_vote(&mut p, &organization, clock, weight, vector[], ts::ctx(scenario));
    ts::return_shared(organization);
    ts::return_shared(p);
}

fun execute_with_sig(
    scenario: &mut ts::Scenario,
    treasury_id: ID,
    binding_id: ID,
    org_id: ID,
    proposal_id: ID,
    vault_id: ID,
    clock: &Clock,
    nonce: u64,
    frost_signature: vector<u8>,
) {
    let treas = ts::take_shared_by_id<OrganizationTreasury>(scenario, treasury_id);
    let binding = ts::take_shared_by_id<TransferBinding>(scenario, binding_id);
    let mut organization = ts::take_shared_by_id<Organization>(scenario, org_id);
    let mut p = ts::take_shared_by_id<Proposal>(scenario, proposal_id);
    let mut vault = ts::take_shared_by_id<AgentVault<SUI>>(scenario, vault_id);
    treasury::execute(&treas, &binding, &mut organization, &mut p, &mut vault, nonce, frost_signature, clock, ts::ctx(scenario));
    ts::return_shared(vault);
    ts::return_shared(p);
    ts::return_shared(organization);
    ts::return_shared(binding);
    ts::return_shared(treas);
}
