module liquidity_core::receipts;

use sui::object::ID;
use liquidity_core::types;

/// Ephemeral swap permit generated by policy pre-hook.
/// Has NO `drop`, `copy`, or `store` - Hot Potato pattern.
/// Must be passed to an authorized AMM pool swap call to be consumed.
public struct SwapPermit {
    pool_id: ID,
    sender: address,
    min_output: u64,
    deadline: u64,
    policy_data: vector<u8>,
}

/// Ephemeral swap receipt returned after successful swap execution.
/// Has NO `drop`, `copy`, or `store` - Hot Potato pattern.
/// Must be consumed by the policy post-hook / policy manager before the PTB can succeed.
public struct SwapReceipt {
    pool_id: ID,
    sender: address,
    amount_in: u64,
    amount_out: u64,
    fee_paid: u64,
    protocol_fee: u64,
    policy_data: vector<u8>,
}

// === SwapPermit Constructor & Destructor ===

public fun create_permit(
    pool_id: ID,
    sender: address,
    min_output: u64,
    deadline: u64,
    policy_data: vector<u8>,
): SwapPermit {
    SwapPermit {
        pool_id,
        sender,
        min_output,
        deadline,
        policy_data,
    }
}

public fun consume_permit(
    permit: SwapPermit,
    expected_pool: ID,
    current_time: u64,
): (address, u64, vector<u8>) {
    let SwapPermit {
        pool_id,
        sender,
        min_output,
        deadline,
        policy_data,
    } = permit;

    assert!(pool_id == expected_pool, types::e_invalid_permit());
    if (deadline > 0) {
        assert!(current_time <= deadline, types::e_expired());
    };

    (sender, min_output, policy_data)
}

public fun permit_pool_id(permit: &SwapPermit): ID { permit.pool_id }
public fun permit_sender(permit: &SwapPermit): address { permit.sender }
public fun permit_min_output(permit: &SwapPermit): u64 { permit.min_output }
public fun permit_deadline(permit: &SwapPermit): u64 { permit.deadline }
public fun permit_policy_data(permit: &SwapPermit): &vector<u8> { &permit.policy_data }

// === SwapReceipt Constructor & Destructor ===

public fun create_receipt(
    pool_id: ID,
    sender: address,
    amount_in: u64,
    amount_out: u64,
    fee_paid: u64,
    protocol_fee: u64,
    policy_data: vector<u8>,
): SwapReceipt {
    SwapReceipt {
        pool_id,
        sender,
        amount_in,
        amount_out,
        fee_paid,
        protocol_fee,
        policy_data,
    }
}

/// Consume a swap receipt that does not have an attached policy
public fun consume_receipt(
    receipt: SwapReceipt,
    expected_pool: ID,
): (address, u64, u64, u64, u64) {
    let SwapReceipt {
        pool_id,
        sender,
        amount_in,
        amount_out,
        fee_paid,
        protocol_fee,
        policy_data,
    } = receipt;

    assert!(pool_id == expected_pool, types::e_invalid_receipt());
    // If a policy is bound to this swap, it MUST be settled through consume_receipt_with_policy!
    assert!(policy_data.is_empty(), types::e_unauthorized());

    (sender, amount_in, amount_out, fee_paid, protocol_fee)
}

/// Consume a swap receipt enforcing the matching PolicyConfig ID
public fun consume_receipt_with_policy(
    receipt: SwapReceipt,
    expected_pool: ID,
    expected_policy_id: ID,
): (address, u64, u64, u64, u64) {
    let SwapReceipt {
        pool_id,
        sender,
        amount_in,
        amount_out,
        fee_paid,
        protocol_fee,
        policy_data,
    } = receipt;

    assert!(pool_id == expected_pool, types::e_invalid_receipt());
    assert!(policy_data == sui::object::id_to_bytes(&expected_policy_id), types::e_unauthorized());

    (sender, amount_in, amount_out, fee_paid, protocol_fee)
}

public fun receipt_pool_id(receipt: &SwapReceipt): ID { receipt.pool_id }
public fun receipt_sender(receipt: &SwapReceipt): address { receipt.sender }
public fun receipt_amount_in(receipt: &SwapReceipt): u64 { receipt.amount_in }
public fun receipt_amount_out(receipt: &SwapReceipt): u64 { receipt.amount_out }
public fun receipt_fee_paid(receipt: &SwapReceipt): u64 { receipt.fee_paid }
public fun receipt_protocol_fee(receipt: &SwapReceipt): u64 { receipt.protocol_fee }
public fun receipt_policy_data(receipt: &SwapReceipt): &vector<u8> { &receipt.policy_data }

#[test]
fun test_permit_and_receipt_lifecycle() {
    let pool_id = object::id_from_address(@0xaaa);
    let policy_id = object::id_from_address(@0xccc);
    let sender = @0xb0b;
    let policy_bytes = sui::object::id_to_bytes(&policy_id);

    // 1. Create Permit
    let permit = create_permit(pool_id, sender, 950, 1000, policy_bytes);
    assert!(permit_pool_id(&permit) == pool_id, 0);
    assert!(permit_sender(&permit) == sender, 1);
    assert!(permit_min_output(&permit) == 950, 2);
    assert!(permit_deadline(&permit) == 1000, 3);

    // 2. Consume Permit (valid time 500 <= 1000)
    let (s, min_out, data) = consume_permit(permit, pool_id, 500);
    assert!(s == sender, 4);
    assert!(min_out == 950, 5);
    assert!(!data.is_empty(), 6);

    // 3. Create Receipt with policy binding
    let receipt = create_receipt(pool_id, sender, 1000, 980, 20, 5, data);
    assert!(receipt_amount_in(&receipt) == 1000, 7);
    assert!(receipt_amount_out(&receipt) == 980, 8);
    assert!(receipt_fee_paid(&receipt) == 20, 9);
    assert!(receipt_protocol_fee(&receipt) == 5, 10);

    // 4. Consume Receipt with policy
    let (rs, r_in, r_out, fee, proto_fee) = consume_receipt_with_policy(receipt, pool_id, policy_id);
    assert!(rs == sender, 11);
    assert!(r_in == 1000, 12);
    assert!(r_out == 980, 13);
    assert!(fee == 20, 14);
    assert!(proto_fee == 5, 15);
}

#[test]
#[expected_failure(abort_code = 1008, location = Self)]
fun test_cannot_bypass_policy_receipt_consumption() {
    let pool_id = object::id_from_address(@0xaaa);
    let policy_id = object::id_from_address(@0xccc);
    let sender = @0xb0b;

    // Create receipt with policy data
    let receipt = create_receipt(pool_id, sender, 1000, 980, 20, 5, sui::object::id_to_bytes(&policy_id));
    // Calling consume_receipt without policy must abort with e_unauthorized (1008)!
    let (_s, _in, _out, _f, _pf) = consume_receipt(receipt, pool_id);
}

#[test]
#[expected_failure(abort_code = 1009, location = Self)]
fun test_permit_expired() {
    let pool_id = object::id_from_address(@0xaaa);
    let sender = @0xb0b;
    let permit = create_permit(pool_id, sender, 950, 100, vector[]);
    // current_time 200 > deadline 100 -> abort
    let (_s, _min_out, _data) = consume_permit(permit, pool_id, 200);
}

#[test_only]
public fun destroy_permit_for_testing(permit: SwapPermit) {
    let SwapPermit { pool_id: _, sender: _, min_output: _, deadline: _, policy_data: _ } = permit;
}

#[test_only]
public fun destroy_receipt_for_testing(receipt: SwapReceipt) {
    let SwapReceipt { pool_id: _, sender: _, amount_in: _, amount_out: _, fee_paid: _, protocol_fee: _, policy_data: _ } = receipt;
}


